# Sao chep thanh .env, cung thu muc manage.py. Khong ghi mat khau vao Git.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=gentleman
POSTGRES_USER=postgres
# Dien mat khau tai khoan PostgreSQL ban dung trong pgAdmin:
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Production: DEBUG=0, secret rieng, host cu the va HTTPS.
