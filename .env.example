# Sao chep thanh .env, cung thu muc manage.py. Khong ghi mat khau vao Git.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=gentleman
POSTGRES_USER=postgres
# Dien mat khau tai khoan PostgreSQL ban dung trong pgAdmin:
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Production: DEBUG=0, secret rieng, host cu the va HTTPS.

# Email demo ghi file trong .local/emails. Khi dung SMTP, dien thong tin rieng:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Gentleman <noreply@example.com>
# POSTGRES_BIN=C:/Program Files/PostgreSQL/17/bin
